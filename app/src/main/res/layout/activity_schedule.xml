<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    tools:context=".modules.schedule.activities.ScheduleActivity">

    <org.mapsforge.map.android.view.MapView
        android:id="@+id/preloadMapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="invisible"
        tools:ignore="MissingConstraints" />

    <!-- Current Date and Time (Top Left) -->
    <TextView
        android:id="@+id/currentDateTimeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2025-01-23 14:00:00"
        android:textSize="@dimen/text_sm"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:padding="@dimen/pad_sm"
        android:background="#FF6200EE"
        android:layout_margin="@dimen/pad_md"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Title "Today's Schedule" (Top Center) -->
    <Button
        android:id="@+id/changeModeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tabulated View"
        android:textSize="@dimen/text_lg"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:padding="@dimen/pad_sm"
        android:background="@drawable/white_border"
        android:gravity="center"
        android:layout_marginTop="@dimen/pad_md"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/emptyStateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No more schedule."
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/changeModeButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <LinearLayout
        android:id="@+id/topRightStatusCluster"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_margin="@dimen/pad_md"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/copyAidButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height_small"
            android:text="Copy AID"
            android:textSize="@dimen/text_btn_copy_aid"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/purple_400"
            android:paddingLeft="@dimen/pad_md"
            android:paddingRight="@dimen/pad_md"
            android:minHeight="@dimen/btn_height_small"
            android:elevation="4dp"
            android:layout_marginEnd="@dimen/gap_sm"/>

        <TextView
            android:id="@+id/connectionStatusTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connected"
            android:textSize="@dimen/text_sm"
            android:textColor="@color/whatsapp_green"
            android:layout_marginEnd="@dimen/gap_sm"/>

        <View
            android:id="@+id/networkStatusIndicator"
            android:layout_width="@dimen/status_dot"
            android:layout_height="@dimen/status_dot"
            android:background="@drawable/circle_shape_green"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pad_sm"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/green"
        style="?android:attr/progressBarStyleHorizontal"
        app:layout_constraintTop_toBottomOf="@id/changeModeButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/fetchingLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp">

        <ImageView
            android:id="@+id/fetchingIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_spinner"
            android:contentDescription="Fetching icon"/>

        <TextView
            android:id="@+id/fetchingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fetching data ."
            android:textSize="20sp"
            android:textColor="@android:color/white"/>
    </LinearLayout>

    <!-- Table Layout for Schedule -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/scheduleRecycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/pad_md"
        android:layout_marginStart="@dimen/pad_md"
        android:layout_marginEnd="@dimen/pad_md"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintBottom_toTopOf="@id/paginationLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/paginationLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/startRouteButtonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnPrevious"
            android:layout_width="@dimen/icon_btn"
            android:layout_height="@dimen/icon_btn"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Previous"
            android:layout_marginEnd="@dimen/gap_sm"/>

        <Button
            android:id="@+id/btnPage1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:padding="@dimen/pad_sm"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnPage2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2"
            android:padding="@dimen/pad_sm"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnPage3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3"
            android:padding="@dimen/pad_sm"
            android:layout_marginEnd="8dp"/>

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_next"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Next"
            android:layout_marginStart="8dp"/>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/timelineContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingTop="0dp"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintBottom_toTopOf="@id/startRouteButtonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.jason.publisher.modules.schedule.widgets.StyledMultiColorTimeline
                android:id="@+id/timelinePart1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.jason.publisher.modules.schedule.widgets.StyledMultiColorTimeline
                android:id="@+id/timelinePart2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.jason.publisher.modules.schedule.widgets.StyledMultiColorTimeline
                android:id="@+id/timelinePart3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </FrameLayout>
    </LinearLayout>

    <!-- Start and Test Buttons (At Bottom Center, Side by Side) -->
    <LinearLayout
        android:id="@+id/startRouteButtonContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/startRouteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/gap_md"
            android:backgroundTint="@color/purple_400"
            android:padding="@dimen/pad_md"
            android:text="Start Route"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_md" />

        <Button
            android:id="@+id/testStartRouteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Test Route"
            android:textSize="18sp"
            android:padding="16dp"
            android:backgroundTint="@color/purple_400"
            android:textColor="@android:color/white"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- App Version -->
    <TextView
        android:id="@+id/versionTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="Version 1.0.1"
        android:textSize="14sp"
        android:textColor="@color/lightGrey"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/darkModeSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dark Mode"
        android:textColor="@color/white"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:checked="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>